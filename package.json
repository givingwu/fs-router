{
	"name": "@feoe/fs-router",
	"version": "0.1.0",
	"author": "https://github.com/givingwu",
	"homepage": "https://givingwu.github.io/fs-router",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/givingwu/fs-router.git"
	},
	"bugs": {
		"url": "https://github.com/givingwu/fs-router/issues"
	},
	"description": "file system based routing",
	"keywords": [
		"file-routing",
		"file-routes",
		"file-system-router",
		"fs-router"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./rspack": {
			"import": {
				"types": "./dist/rspack.d.ts",
				"default": "./dist/rspack.js"
			},
			"require": {
				"types": "./dist/rspack.d.cts",
				"default": "./dist/rspack.cjs"
			}
		},
		"./webpack": {
			"import": {
				"types": "./dist/webpack.d.ts",
				"default": "./dist/webpack.js"
			},
			"require": {
				"types": "./dist/webpack.d.cts",
				"default": "./dist/webpack.cjs"
			}
		},
		"./vite": {
			"import": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			},
			"require": {
				"types": "./dist/vite.d.cts",
				"default": "./dist/vite.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rslib build && node scripts/build-types.mjs",
		"dev": "rslib build --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "simple-git-hooks",
		"prepublishOnly": "pnpm check && pnpm typecheck && pnpm test && pnpm check:consumers",
		"docs:dev": "rspress dev --config docs/.rspress/config.ts",
		"docs:build": "rspress build --config docs/.rspress/config.ts",
		"docs:preview": "rspress preview --config docs/.rspress/config.ts",
		"check": "biome ci --error-on-warnings .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --project tsconfig.check.json --noEmit",
		"docs:check": "node scripts/check-docs.mjs",
		"check:package": "node scripts/check-package.mjs",
		"check:consumers": "node scripts/check-consumers.mjs",
		"prepack": "pnpm build && pnpm check:package",
		"docs:smoke": "playwright test --config tests/browser/docs.config.ts",
		"example:setup": "node scripts/setup-example.mjs",
		"example:check": "npm --prefix examples/minimal-react run build:all",
		"example:smoke": "playwright test --config tests/browser/example.config.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.13",
		"@loadable/component": "5.16.7",
		"@microsoft/api-extractor": "7.59.1",
		"@playwright/test": "1.63.0",
		"@rslib/core": "^0.4.1",
		"@rspack/core": "1.7.12",
		"@rspress/theme-default": "^1.47.2",
		"@types/loadable__component": "5.13.10",
		"@types/node": "^22.20.2",
		"@types/react": "^18.3.31",
		"react": "^18.3.1",
		"react-dom": "18.3.1",
		"react-router-dom": "7.18.3",
		"rspress": "^1.47.2",
		"simple-git-hooks": "2.13.0",
		"vite": "^6.4.3",
		"vitest": "^4.1.11",
		"webpack": "^5.110.3"
	},
	"simple-git-hooks": {
		"pre-push": "pnpm test"
	},
	"dependencies": {
		"typescript": "^5.9.3",
		"unplugin": "^2.3.11"
	},
	"peerDependencies": {
		"@loadable/component": "^5.16.7",
		"@rspack/core": "^1.7.12",
		"@types/react": "^18.3.31 || ^19.2.0",
		"react": "^18.3.1 || ^19.2.8",
		"react-dom": "^18.3.1 || ^19.2.8",
		"react-router-dom": "^7.18.3",
		"vite": "^6.4.3",
		"webpack": "^5.110.3"
	},
	"license": "MIT",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22.12.0"
	},
	"pnpm": {
		"overrides": {
			"refractor@3>prismjs": "1.30.0"
		},
		"patchedDependencies": {
			"@rspress/theme-default@1.47.2": "patches/@rspress__theme-default@1.47.2.patch"
		}
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"webpack": {
			"optional": true
		},
		"@rspack/core": {
			"optional": true
		}
	}
}
