{
	"name": "@feoe/fs-router",
	"version": "0.0.13",
	"author": "https://github.com/givingwu",
	"homepage": "https://givingwu.github.io/fs-router",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/givingwu/fs-router.git"
	},
	"bugs": {
		"url": "https://github.com/givingwu/fs-router/issues"
	},
	"description": "file system based routing",
	"keywords": [
		"file-routing",
		"file-routes",
		"file-system-router",
		"fs-router"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./rspack": {
			"types": "./dist/plugin/rspack.d.ts",
			"import": "./dist/rspack.js",
			"require": "./dist/rspack.cjs"
		},
		"./webpack": {
			"types": "./dist/plugin/webpack.d.ts",
			"import": "./dist/webpack.js",
			"require": "./dist/webpack.cjs"
		},
		"./vite": {
			"types": "./dist/plugin/vite.d.ts",
			"import": "./dist/vite.js",
			"require": "./dist/vite.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rslib build",
		"dev": "rslib build --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "simple-git-hooks",
		"prepublishOnly": "pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm check:package",
		"docs:dev": "rspress dev docs",
		"docs:build": "rspress build docs --config docs/.rspress/config.ts",
		"docs:preview": "rspress preview docs",
		"check": "biome ci --error-on-warnings .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --project tsconfig.check.json --noEmit",
		"docs:check": "node scripts/check-docs.mjs",
		"check:package": "node scripts/check-package.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@rslib/core": "^0.4.1",
		"@rspress/theme-default": "^1.47.2",
		"@types/node": "^22.20.2",
		"@types/react": "^18.3.31",
		"react": "^18.3.1",
		"rspress": "^1.47.2",
		"simple-git-hooks": "2.13.0",
		"vite": "^6.4.3",
		"vitest": "^4.1.11",
		"webpack": "^5.110.3"
	},
	"simple-git-hooks": {
		"pre-push": "pnpm test"
	},
	"dependencies": {
		"chokidar": "^4.0.3",
		"glob": "^13.0.6",
		"react-router-dom": "^6.30.6",
		"typescript": "^5.9.3",
		"unplugin": "^2.3.11"
	},
	"peerDependencies": {
		"@types/react": "^18.2.48",
		"react": "^18.2.0"
	},
	"license": "MIT",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22"
	},
	"pnpm": {
		"overrides": {
			"refractor@3>prismjs": "1.30.0"
		}
	}
}
